# Neon: use the pooled URL for runtime and the direct URL for Prisma migrations.
# Keep both URLs private. Get them from the Neon project's Connect dialog.
DATABASE_URL=
DIRECT_URL=

# Admin password hash, generated locally with `npm run admin:provision`.
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=
ORDER_ACCESS_SECRET=

# Razorpay Standard Checkout (server-only secrets must never use NEXT_PUBLIC_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required only for the admin product-image upload endpoint.
BLOB_READ_WRITE_TOKEN=

# Public canonical app URL (for metadata and password-reset emails). Use your local or production URL.
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000


# Password reset email delivery (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-store-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="Chaudhary General Store <your-store-email@gmail.com>"

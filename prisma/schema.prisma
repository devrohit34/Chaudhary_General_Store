generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  confirmed
  processing
  out_for_delivery
  delivered
  cancelled
  returned
}

enum PaymentMethod {
  cod
  upi
  phonepe
  googlepay
  paytm
  card
  razorpay
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  cancelled
  refunded
  pending_verification
  rejected
}

enum RefundStatus {
  pending
  processing
  completed
  failed
  requires_review
  not_applicable
}

enum AdminRole {
  admin
  manager
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameHi      String?   @map("name_hi")
  slug        String    @unique
  icon        String?
  imageUrl    String?   @map("image_url")
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                String    @id @default(cuid())
  categoryId        String?   @map("category_id")
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  nameHi            String?   @map("name_hi")
  slug              String    @unique
  description       String?
  descriptionHi     String?   @map("description_hi")
  brand             String?
  sku               String?   @unique
  pricePaise        Int       @map("price_paise")
  originalPricePaise Int?     @map("original_price_paise")
  discountPercent   Int       @default(0) @map("discount_percent")
  unit              String    @default("piece")
  weight            String?
  stockQuantity     Int       @default(0) @map("stock_quantity")
  minStockAlert     Int       @default(10) @map("min_stock_alert")
  imageUrl          String?   @map("image_url")
  images            String[]  @default([])
  tags              String[]  @default([])
  isActive          Boolean   @default(true) @map("is_active")
  isFeatured        Boolean   @default(false) @map("is_featured")
  isFlashSale       Boolean   @default(false) @map("is_flash_sale")
  flashSalePricePaise Int?    @map("flash_sale_price_paise")
  flashSaleEndsAt   DateTime? @map("flash_sale_ends_at")
  rating            Float     @default(0)
  reviewCount       Int       @default(0) @map("review_count")
  gstBasisPoints    Int       @default(500) @map("gst_basis_points")
  hsnCode           String?   @map("hsn_code")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  orderItems        OrderItem[]
  reviews           Review[]
  wishlistedBy      WishlistItem[]

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@index([stockQuantity])
  @@map("products")
}

model Customer {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String            @map("password_hash")
  fullName       String            @map("full_name")
  phone          String?
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlistItems  WishlistItem[]

  @@map("customers")
}

model Address {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String   @default("Home")
  fullName     String   @map("full_name")
  phone        String
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  postalCode   String   @map("postal_code")
  landmark     String?
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([customerId, isDefault])
  @@map("addresses")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique @map("order_number")
  customerId            String?       @map("customer_id")
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String        @map("customer_name")
  customerEmail         String?       @map("customer_email")
  customerPhone         String        @map("customer_phone")
  addressSnapshot       Json          @map("address_snapshot")
  status                OrderStatus   @default(pending)
  paymentMethod         PaymentMethod @map("payment_method")
  paymentStatus         PaymentStatus @default(pending) @map("payment_status")
  subtotalPaise         Int           @map("subtotal_paise")
  deliveryChargePaise   Int           @default(0) @map("delivery_charge_paise")
  discountPaise         Int           @default(0) @map("discount_paise")
  gstPaise              Int           @default(0) @map("gst_paise")
  totalPaise            Int           @map("total_paise")
  currency              String        @default("INR")
  deliverySlot          String?       @map("delivery_slot")
  deliveryOtp           String?       @map("delivery_otp")
  isExpress             Boolean       @default(false) @map("is_express")
  inventoryReleased     Boolean       @default(false) @map("inventory_released")
  utrNumber             String?       @map("utr_number")
  paymentScreenshotUrl  String?       @map("payment_screenshot_url")
  qrCreatedAt           DateTime?     @map("qr_created_at")
  upiVerifiedAt         DateTime?     @map("upi_verified_at")
  upiRejectedReason     String?       @map("upi_rejected_reason")
  deliveredAt           DateTime?     @map("delivered_at")
  cancelledAt           DateTime?     @map("cancelled_at")
  cancellationReason    String?       @map("cancellation_reason")
  cancellationActor     String?       @map("cancellation_actor")
  cancellationPreviousStatus OrderStatus? @map("cancellation_previous_status")
  idempotencyKey        String?       @unique @map("idempotency_key")
  guestAccessTokenHash  String?       @map("guest_access_token_hash")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  items                 OrderItem[]
  payments              Payment[]
  refundOperation       RefundOperation?

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String   @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?  @map("product_id")
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String   @map("product_name")
  productImage   String?  @map("product_image")
  brand          String?
  unit           String?
  unitPricePaise Int      @map("unit_price_paise")
  quantity       Int
  lineTotalPaise Int      @map("line_total_paise")
  gstBasisPoints Int      @default(500) @map("gst_basis_points")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String        @map("order_id")
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway             String
  gatewayOrderId      String?       @unique @map("gateway_order_id")
  gatewayPaymentId    String?       @unique @map("gateway_payment_id")
  signature           String?
  status              PaymentStatus @default(pending)
  amountPaise         Int           @map("amount_paise")
  currency            String        @default("INR")
  verifiedAt          DateTime?     @map("verified_at")
  capturedAt          DateTime?     @map("captured_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([orderId, status])
  @@map("payments")
}

model RefundOperation {
  id               String       @id @default(cuid())
  orderId          String       @unique @map("order_id")
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          String       @default("razorpay")
  gatewayPaymentId String?      @map("gateway_payment_id")
  gatewayRefundId  String?      @unique @map("gateway_refund_id")
  amountPaise      Int          @map("amount_paise")
  status           RefundStatus @default(pending)
  attemptCount     Int          @default(0) @map("attempt_count")
  lastAttemptAt    DateTime?    @map("last_attempt_at")
  lastError        String?      @map("last_error")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@map("refund_operations")
}

model WebhookEvent {
  id             String    @id @default(cuid())
  gateway        String
  eventId        String    @unique @map("event_id")
  eventType      String    @map("event_type")
  gatewayOrderId String?   @map("gateway_order_id")
  gatewayPaymentId String? @map("gateway_payment_id")
  gatewayRefundId String?  @map("gateway_refund_id")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([gatewayOrderId])
  @@map("webhook_events")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(admin)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  description        String?
  discountType       String   @map("discount_type")
  discountValue      Int      @map("discount_value")
  minOrderPaise      Int      @default(0) @map("min_order_paise")
  maxDiscountPaise   Int?     @map("max_discount_paise")
  usageLimit         Int?     @map("usage_limit")
  usedCount          Int      @default(0) @map("used_count")
  validFrom          DateTime @default(now()) @map("valid_from")
  validUntil         DateTime? @map("valid_until")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

model Review {
  id         String    @id @default(cuid())
  customerId String    @map("customer_id")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String    @map("product_id")
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  body       String?
  isVerified Boolean   @default(false) @map("is_verified")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([customerId, productId])
  @@index([productId, createdAt])
  @@map("reviews")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String   @map("image_url")
  linkUrl     String?  @map("link_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("banners")
}

model PaymentAttachment {
  id          String   @id @default(cuid())
  orderNumber String   @map("order_number")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderNumber, createdAt])
  @@map("payment_attachments")
}
